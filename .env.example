DATABASE_URL=
PORT=3321
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
JWT_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
# socket.io admin-ui(인증 없음)를 켤 때만 true
REALTIME_ADMIN_UI=false

# Local development: tracing disabled. Compose defaults to enabled when unset.
DD_TRACE_ENABLED=false
DD_SERVICE=aideep-websocket
DD_ENV=prod
# DD_VERSION is set from IMAGE_TAG by Compose.
# DD_TRACE_AGENT_URL=unix:///var/run/datadog/apm.socket
# DD_SOCKET_DIR=/var/run/datadog
# Address reachable from the Datadog Agent (not from this application).
# DD_METRICS_ENDPOINT=http://host.docker.internal:3321/metrics
