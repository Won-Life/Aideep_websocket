# ─── 보안 ───
# 1) 라이프사이클 스크립트 차단 (이번 사건의 핵심 방어선)
#    pnpm 10+ 부터는 기본값이 false. 명시적으로 박아둡니다.
ignore-scripts=true

# 2) 빌드 허용 목록 (네이티브 바인딩 필요한 패키지만 골라서 풀어주기)
#    pnpm 9.5+ 의 onlyBuiltDependencies 기능
#    이건 package.json의 pnpm 필드에서 관리 (아래 참고)

# 3) 강한 lockfile 검증
verify-store-integrity=true
strict-peer-dependencies=true

# 4) lockfile 없으면 install 실패 (CI에서 안전장치)
frozen-lockfile=true

# ─── 의존성 해석 엄격화 ───
# 5) hoisting 최소화 — phantom dependency 방지
#    선언하지 않은 패키지가 우연히 import되는 사고 차단
hoist=false
shamefully-hoist=false

# 6) 정확한 버전 저장 (^, ~ 대신 정확한 버전 핀)
save-exact=true

# 7) lockfile 위반 시 자동 수정 안 함
prefer-frozen-lockfile=true

# ─── 최소 출시 후 대기 (이건 .npmrc가 아니라 Renovate/Dependabot 설정) ───
# 신규 버전을 즉시 받지 않음 — 별도 도구로 관리